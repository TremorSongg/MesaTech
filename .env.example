# Copiar a .env y reemplazar los valores ficticios (el .env real NO se versiona).
# Usar contraseñas alfanumericas.

# --- MySQL: una instancia por microservicio (en AWS son dos RDS distintas) ---
MYSQL_ROOT_PASSWORD=cambiar_root_local
CATALOGO_DB_NAME=catalogo_db
CATALOGO_DB_USER=catalogo_app
CATALOGO_DB_PASSWORD=cambiar_password_catalogo
SOLICITUDES_DB_NAME=solicitudes_db
SOLICITUDES_DB_USER=solicitudes_app
SOLICITUDES_DB_PASSWORD=cambiar_password_solicitudes

# --- RabbitMQ (ver tambien rabbitmq/.env.example) ---
RABBITMQ_ADMIN_USER=admin_mesatech
RABBITMQ_ADMIN_PASSWORD=cambiar_password_admin
RABBITMQ_PUBLICADOR_USER=catalogo_publicador
RABBITMQ_PUBLICADOR_PASSWORD=cambiar_password_publicador
RABBITMQ_CONSUMIDOR_USER=solicitudes_consumidor
RABBITMQ_CONSUMIDOR_PASSWORD=cambiar_password_consumidor
RABBITMQ_VHOST=mesatech
RABBITMQ_EXCHANGE=catalogo.exchange
RABBITMQ_QUEUE=solicitudes.catalogo.queue
RABBITMQ_ROUTING_KEY=categoria.creada

# --- Perfil prod: Microsoft Entra ID (issuer y audience = valores de tu app registration) ---
ENTRA_ISSUER_URI=https://login.microsoftonline.com/<TENANT_ID>/v2.0
ENTRA_AUDIENCE=<CLIENT_ID>

# --- Frontend local sin login (VITE_AUTH_ENABLED=false) ---
VITE_MOCK_ROLE=ADMINISTRADOR
