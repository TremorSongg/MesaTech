resource "aws_security_group" "frontend" {
  name        = "mesatech-sg-frontend"
  description = "Frontend EC2: HTTP publico + SSH"
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "HTTP publico"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "mesatech-sg-frontend" }
}

resource "aws_security_group" "backend" {
  name        = "mesatech-sg-backend"
  description = "Backend EC2: BFF puerto 8080 + SSH"
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "BFF - API Gateway y debug"
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "mesatech-sg-backend" }
}

resource "aws_security_group" "db" {
  name        = "mesatech-sg-db"
  description = "DB EC2: PostgreSQL solo desde backend + SSH"
  vpc_id      = aws_vpc.main.id

  ingress {
    description     = "PostgreSQL desde backend"
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.backend.id]
  }

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "mesatech-sg-db" }
}
