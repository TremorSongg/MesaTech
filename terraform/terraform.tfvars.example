# Copiar a terraform.tfvars y completar (terraform.tfvars NO se versiona).
# Usar passwords alfanumericas (se insertan en SQL y en archivos .env).

# Microsoft Entra ID (portal Azure > App registrations > api-cloud-native)
azure_client_id = "<CLIENT_ID>"
azure_tenant_id = "<TENANT_ID>"

# Tu IP publica con /32 (SSH y consola de RabbitMQ). Agregar las de tus companeros si la necesitan.
admin_cidrs = ["203.0.113.10/32"]

# Clave publica derivada del .pem del Learner Lab:  ssh-keygen -y -f Credenciales/labsuser.pem
ssh_public_key = "ssh-rsa AAAA..."

# RDS: administradores y usuarios de aplicacion (una pareja por instancia)
catalogo_db_master_password    = "CAMBIAR_admin_catalogo"
catalogo_db_app_password       = "CAMBIAR_app_catalogo"
solicitudes_db_master_password = "CAMBIAR_admin_solicitudes"
solicitudes_db_app_password    = "CAMBIAR_app_solicitudes"

# RabbitMQ: deben ser identicas a RABBITMQ_*_PASSWORD de rabbitmq/.env en la EC2 C
rabbit_publicador_password = "CAMBIAR_publicador"
rabbit_consumidor_password = "CAMBIAR_consumidor"
